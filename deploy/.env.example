# Production Compose environment template.
# Copy this file to deploy/.env, replace every replace-with-* value, and keep
# deploy/.env outside source control. This file contains no real credentials.

# -----------------------------------------------------------------------------
# Compose and public edge
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=exchange-platform
BACKEND_IMAGE=goexchange-backend:local
API_DOMAIN=api.example.com
TRUSTED_PROXY_CIDRS=172.30.0.0/24
CORS_ALLOWED_ORIGINS=https://app.example.com

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=goexchange
POSTGRES_DB=goexchange
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
DATABASE_DSN=host=db user=goexchange password=replace-with-long-random-postgres-password dbname=goexchange port=5432 sslmode=disable TimeZone=UTC

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-with-long-random-redis-password
REDIS_DB=0

# -----------------------------------------------------------------------------
# Kafka and Debezium Connect
# -----------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
# Generate a unique KRaft id for a new production data directory.
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_CONNECT_GROUP_ID=exchange-platform-connect
CDC_CONNECT_URL=http://kafka-connect:8083
CDC_DATABASE_USER=
CDC_DATABASE_PASSWORD=
CDC_DATABASE_SSLMODE=disable
CDC_DATABASE_SSLCERT=
CDC_DATABASE_SSLKEY=
CDC_DATABASE_SSLROOTCERT=
OUTBOX_CUTOVER_CONFIRM_PRELAUNCH=false

# -----------------------------------------------------------------------------
# MinIO object storage
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-long-random-minio-secret
MINIO_BUCKET=go-exchange
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# JWT key mounts
# -----------------------------------------------------------------------------
# These are host paths. The containers mount them read-only at
# /run/secrets/jwt/private.pem and /run/secrets/jwt/public.
JWT_PRIVATE_KEY_FILE=/srv/exchange-platform/.secrets/jwt/private.pem
JWT_VERIFY_KEYS_DIR=/srv/exchange-platform/.secrets/jwt/public
JWT_ACTIVE_KID=prod-v1
JWT_ISSUER=go.exchange
JWT_AUDIENCE=go.exchange.api
JWT_ACCESS_TTL=15m
JWT_REFRESH_IDLE_TTL=168h
JWT_REFRESH_ABSOLUTE_TTL=720h
JWT_CLOCK_SKEW=30s

# -----------------------------------------------------------------------------
# Translation and embeddings
# -----------------------------------------------------------------------------
TRANSLATION_ENABLED=false
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=@cf/google/gemma-4-26b-a4b-it
TRANSLATION_PROMPT_VERSION=social_v4
TRANSLATION_TIMEOUT_SECONDS=10
TRANSLATION_CACHE_TTL_HOURS=168
TRANSLATION_CACHE_JITTER_HOURS=24
TRANSLATION_MAX_SOURCE_RUNES=2000
TRANSLATION_MAX_COMPLETION_TOKENS=2048

EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_VERSION=post_embedding_v1
EMBEDDING_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# AI worker and recommendation telemetry
# -----------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=
RECOMMENDATION_TELEMETRY_ENABLED=true
RECOMMENDATION_TELEMETRY_ROLLOUT_PERCENT=100
RECOMMENDATION_TELEMETRY_SIGNING_KEY=replace-with-long-random-telemetry-signing-key
RECOMMENDATION_TELEMETRY_TOKEN_TTL=24h
RECOMMENDATION_TELEMETRY_MAX_CLOCK_SKEW=5m
RECOMMENDATION_TELEMETRY_EVENTS_PER_MINUTE=1000
ARTICLE_VIEW_EVENTS_PER_MINUTE=300

# -----------------------------------------------------------------------------
# DevData source adapters
# -----------------------------------------------------------------------------
# Required only when the devdata profile is explicitly run. There is no
# RSSHub service in this Compose file; point this at the reachable RSSHub.
DEVDATA_SOURCE=rsshub
RSSHUB_BASE_URL=https://rsshub.example.com
RSSHUB_TIMEOUT=60s
X_API_BASE_URL=https://api.x.com
X_API_TIMEOUT=20s
X_BEARER_TOKEN=
DEVDATA_FETCH_BATCH_SIZE=3
DEVDATA_FETCH_BATCH_DELAY=60s
DEVDATA_INCREMENTAL_FETCH_COUNT=20

# -----------------------------------------------------------------------------
# Worker tuning
# -----------------------------------------------------------------------------
WORKER_HEALTH_PORT=8081
LIKE_BEHAVIOR_BATCH_SIZE=500
LIKE_BEHAVIOR_CLAIM_LEASE=30s
LIKE_BEHAVIOR_FLUSH_INTERVAL=1s
LIKE_BEHAVIOR_PROJECTION_CONSUMERS=6

# -----------------------------------------------------------------------------
# Optional observability profile
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-long-random-grafana-password
