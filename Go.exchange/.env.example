# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------

# Local Docker Compose normally supplies its own default.
# Set this when running backend commands outside Compose.
DATABASE_DSN=host=127.0.0.1 user=postgres password=1234 dbname=test port=5432 sslmode=disable TimeZone=Asia/Shanghai


# -------------------------------------------------------------------
# JWT
# -------------------------------------------------------------------

# Generate local keys first:
# go run ./cmd/gen-jwt-keys --kid local-dev-v1 --out .secrets/jwt
JWT_ACTIVE_KID=local-dev-v1
JWT_PRIVATE_KEY_FILE=.secrets/jwt/private.pem
JWT_VERIFY_KEYS_DIR=.secrets/jwt/public
JWT_ISSUER=go.exchange
JWT_AUDIENCE=go.exchange.api
JWT_ACCESS_TTL=15m
JWT_REFRESH_IDLE_TTL=168h
JWT_REFRESH_ABSOLUTE_TTL=720h
JWT_CLOCK_SKEW=30s


# -------------------------------------------------------------------
# Recommendation telemetry
# -------------------------------------------------------------------

RECOMMENDATION_TELEMETRY_ENABLED=true
RECOMMENDATION_TELEMETRY_ROLLOUT_PERCENT=100

# Example development value only. Non-local environments must inject
# their own secret outside source control.
RECOMMENDATION_TELEMETRY_SIGNING_KEY=local-development-only-recommendation-key

RECOMMENDATION_TELEMETRY_TOKEN_TTL=24h
RECOMMENDATION_TELEMETRY_MAX_CLOCK_SKEW=5m
RECOMMENDATION_TELEMETRY_EVENTS_PER_MINUTE=1000


# -------------------------------------------------------------------
# AI worker
# -------------------------------------------------------------------

AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com


# -------------------------------------------------------------------
# MinIO / object storage
# -------------------------------------------------------------------

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=go-exchange
MINIO_USE_SSL=false
