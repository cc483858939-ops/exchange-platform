{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum(rate(go_exchange_http_requests_total[1m]))", "legendFormat": "qps", "refId": "A" }],
      "title": "Total HTTP QPS",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(go_exchange_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }],
      "title": "Overall HTTP P95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum(rate(go_exchange_http_requests_total{status=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(go_exchange_http_requests_total[1m])), 0.000001)", "legendFormat": "error rate", "refId": "A" }],
      "title": "HTTP Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (method, route) (rate(go_exchange_http_requests_total[1m]))", "legendFormat": "{{method}} {{route}}", "refId": "A" }],
      "title": "QPS by Route",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(go_exchange_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{method}} {{route}}", "refId": "A" }],
      "title": "P95 by Route",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (method, route) (rate(go_exchange_http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "{{method}} {{route}}", "refId": "A" }],
      "title": "5xx by Route",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, strategy_id) (rate(go_exchange_recommendation_generation_duration_seconds_bucket[5m])))", "legendFormat": "{{strategy_id}}", "refId": "A" }],
      "title": "Recommendation Generation P95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (outcome, strategy_id) (rate(go_exchange_recommendation_requests_total[1m]))", "legendFormat": "{{outcome}} {{strategy_id}}", "refId": "A" }],
      "title": "Recommendation Request Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "worker_pipeline_backlog", "legendFormat": "{{pipeline}}", "refId": "A" }],
      "title": "Worker Pipeline Backlog",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "worker_pipeline_healthy", "legendFormat": "healthy {{pipeline}}", "refId": "A" },
        { "expr": "worker_pipeline_backlog_stalled", "legendFormat": "stalled {{pipeline}}", "refId": "B" }
      ],
      "title": "Worker Pipeline Health",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "go_exchange_notification_consumer_lag", "legendFormat": "lag", "refId": "A" }],
      "title": "Notification Consumer Lag",
      "type": "timeseries"
    }
  ],
