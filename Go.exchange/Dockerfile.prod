# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.25.3-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-api ./cmd/api \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-worker ./cmd/worker \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-migrate ./cmd/migrate \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-kafka-init ./cmd/kafka-init \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-cdc-init ./cmd/cdc-init \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-outbox-cutover ./cmd/outbox-cutover \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-devdata ./cmd/devdata \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-post-media-gc ./cmd/post-media-gc \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -o /out/go-exchange-kafka-dlq ./cmd/kafka-dlq

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/go-exchange-api /app/go-exchange-api
COPY --from=builder /out/go-exchange-worker /app/go-exchange-worker
COPY --from=builder /out/go-exchange-migrate /app/go-exchange-migrate
COPY --from=builder /out/go-exchange-kafka-init /app/go-exchange-kafka-init
COPY --from=builder /out/go-exchange-cdc-init /app/go-exchange-cdc-init
COPY --from=builder /out/go-exchange-outbox-cutover /app/go-exchange-outbox-cutover
COPY --from=builder /out/go-exchange-devdata /app/go-exchange-devdata
COPY --from=builder /out/go-exchange-post-media-gc /app/go-exchange-post-media-gc
COPY --from=builder /out/go-exchange-kafka-dlq /app/go-exchange-kafka-dlq
COPY config /app/config

EXPOSE 3000
